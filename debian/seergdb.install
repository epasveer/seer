#!/usr/bin/dh-exec
# dh-exec is needed for renaming
src/resources/icons/hicolor/32x32/seergdb.png => usr/share/icons/hicolor/32x32/apps/seergdb.png
src/resources/icons/hicolor/64x64/seergdb.png => usr/share/icons/hicolor/64x64/apps/seergdb.png
src/resources/icons/hicolor/128x128/seergdb.png => usr/share/icons/hicolor/128x128/apps/seergdb.png
src/resources/icons/hicolor/256x256/seergdb.png => usr/share/icons/hicolor/256x256/apps/seergdb.png
src/resources/icons/hicolor/512x512/seergdb.png => usr/share/icons/hicolor/512x512/apps/seergdb.png

src/resources/seergdb.desktop usr/share/applications
